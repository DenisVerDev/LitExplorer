@inherits LayoutComponentBase
@inject StorageService Storage
@inject IJSRuntime JS

<header>
	<NavMenu IsDarkTheme="isDarkTheme" OnToggleTheme="ToggleThemeAsync" />
</header>
<main>
	@Body
</main>

@code{
	private const string themeKey = "isDarkTheme";
	private bool isDarkTheme = false; // light theme by default

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			var theme = await Storage.GetValueAsync<bool>(themeKey);
			isDarkTheme = theme != null ? (bool)theme : false;

			await ApplyThemeAsync();
		}
	}

	private async Task ApplyThemeAsync()
	{
		await JS.InvokeVoidAsync("toggleTheme", isDarkTheme);
		StateHasChanged();
	}

	private async Task ToggleThemeAsync()
	{
		isDarkTheme = !isDarkTheme;
		await Storage.SaveValueAsync(themeKey, isDarkTheme);
		await ApplyThemeAsync();
	}
}
