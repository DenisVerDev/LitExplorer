@inject NavigationManager NavManager
@inject UserService UserService

<nav class="navbar navbar-expand-sm shadow-sm p-md-2 p-3">
	<div class="container">
		<div class="row w-100 align-items-start">
			<div class="col-9 d-flex flex-wrap align-items-center ps-md-5 ps-0">
				<a class="navbar-brand" aria-current="page" href="/">
					LitExplorer
				</a>
				<div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
					<ul class="navbar-nav">
						<li class="nav-item ms-lg-5 me-5">
							<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Recommendations" ? "active" : "")" href="/Recommendations">
								Recommendations
							</a>
						</li>
						<li class="nav-item ms-lg-5 me-5">
							<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Browse" ? "active" : "")" href="/Browse">
								Browse
							</a>
						</li>
						<li class="nav-item ms-lg-5 me-5">
							<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Library" ? "active" : "")" href="/Library">
								Library
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="col-3 d-flex justify-content-center align-items-center">
				<button class="btn btn-theme rounded-circle d-flex align-items-center justify-content-center me-3" @onclick="async ()=>await OnToggleTheme.InvokeAsync()">
					<span style="line-height: 1;">
						@(IsDarkTheme ? "🌙" : "🌞")
					</span>
				</button>
				<a class="nav-link me-4" @onclick="ProfileNavigation">
					@(UserService.SessionUser == null ? "Sign in" : UserService.SessionUser.Email)
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
				aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
			</div>
		</div>
	</div>
</nav>

@code{
	[Parameter]
	public bool IsDarkTheme { get; set; }

	[Parameter]
	public EventCallback OnToggleTheme { get; set; }

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
			await UserService.LoadSessionUserAsync();
	}

	private void ProfileNavigation()
	{
		if (UserService.SessionUser == null)
			NavManager.NavigateTo("Authorization");
	}
}
