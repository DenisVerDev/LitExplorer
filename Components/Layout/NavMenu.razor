@inject NavigationManager NavManager
@inject StorageService Storage
@inject IJSRuntime JS

<nav class="navbar navbar-expand-sm shadow-sm p-md-2 p-3">
	<div class="container">
		<div class="row w-100 align-items-start">
			<div class="col-9 d-flex flex-wrap align-items-center ps-md-5 ps-0">
				<a class="navbar-brand" aria-current="page" href="/">
					LitExplorer
				</a>
				<div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
					<ul class="navbar-nav">
						<li class="nav-item ms-lg-5 me-5">
							<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Recommendations" ? "active" : "")" href="/Recommendations">
								Recommendations
							</a>
						</li>
						<li class="nav-item ms-lg-5 me-5">
							<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Browse" || NavManager.ToBaseRelativePath(NavManager.Uri) == "" ? "active" : "")" href="/Browse">
								Browse
							</a>
						</li>
						@if (SessionUser != null)
						{
							<li class="nav-item ms-lg-5 me-5">
								<a class="nav-link @(NavManager.ToBaseRelativePath(NavManager.Uri) == "Library" ? "active" : "")" href="/Library">
									Library
								</a>
							</li>
						}
					</ul>
				</div>
			</div>
			<div class="col-3 d-flex justify-content-center align-items-center">
				<button class="btn btn-theme rounded-circle d-flex align-items-center justify-content-center me-3" @onclick="async ()=>await OnToggleTheme.InvokeAsync()">
					<span style="line-height: 1;">
						@(IsDarkTheme ? "🌙" : "🌞")
					</span>
				</button>
				<div class="position-relative">
					<a class="nav-link me-4" @onclick="ProfileNavigation">
						@(SessionUser == null ? "Sign in" : "Profile")
					</a>
					@if(SessionUser != null && showProfileDropDown)
					{
						<div class="profile-dropdown" id="profileDropDown" tabindex="0" @onfocusout="HandleProfileFocus">
							<div class="profile-email" title="@SessionUser.Email">@SessionUser.Email</div>
							<button class="btn-signout" @onmousedown="()=>signoutFocus=true" @onmouseleave="()=>signoutFocus=false" @onclick="SignOutAsync">Sign out</button>
						</div>
					}
				</div>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
				aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
			</div>
		</div>
	</div>
</nav>

@code{
	[Parameter]
	public bool IsDarkTheme { get; set; }

	[Parameter]
	public EventCallback OnToggleTheme { get; set; }

	private const string userKey = "sessionUser";
	private UserDTO? SessionUser { get; set; } = null;

	private bool showProfileDropDown = false;
	private bool signoutFocus = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
			SessionUser = (await Storage.GetValueAsync<UserDTO>(userKey)) as UserDTO;

		if (showProfileDropDown)
			await JS.InvokeVoidAsync("focusElementRef", "profileDropDown");
	}

	private void ProfileNavigation()
	{
		if (SessionUser == null)
			NavManager.NavigateTo("Authorization");
		else showProfileDropDown = !showProfileDropDown;
	}

	private async Task SignOutAsync()
	{
		SessionUser = null;
		await Storage.DeleteValueAsync(userKey);
		NavManager.NavigateTo("Browse");
	}

	private void HandleProfileFocus(FocusEventArgs args)
	{
		if (!signoutFocus)
			showProfileDropDown = false;
	}
}
