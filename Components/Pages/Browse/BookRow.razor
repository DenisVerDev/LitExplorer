<div class="row w-100 book-row p-3 d-flex align-items-start position-relative">
	<div class="col-12 col-md-2 mb-2">
		<img class="w-100" src="@(SelectedBookSource.BookMeta.CoverImageUrl ?? "/images/default-cover.png")" alt="@Book.Title" />
	</div>
	<div class="col-12 col-md-10">
		<h5 class="fw-semibold text-dark d-inline">@Book.Title</h5>
		@foreach (var bookSource in Book.BookSources)
		{
			@if(SelectedBookSource.BookSourceId == bookSource.BookSourceId)
			{
				{
					SelectedAuthor = Authors.Where(a => a.AuthorId == bookSource.BookMeta.AuthorId).First();
					SelectedSource = Sources.Where(s => s.SourceId == bookSource.SourceId).First();
				}
				<h6 class="fw-normal text-dark d-block">by @SelectedAuthor.AuthorName</h6>
				<div class="d-flex flex-wrap small text-muted">
					<div>
						<span>Rating: @bookSource.BookMeta.AverageRating</span>
						<span class="ms-lg-1">Ratings: @bookSource.BookMeta.RatingsCount</span>
						<span class="ms-lg-1">Views: @bookSource.BookMeta.TotalViewsCount</span>
						<span class="ms-lg-1">Readers: @bookSource.BookMeta.ReadersCount</span>
						<span class="ms-lg-1">Chapters: @bookSource.BookMeta.ChaptersCount</span>
					</div>
					<div>
						<span>First chapter: @bookSource.BookMeta.FirstChapterReleaseDate!.Value.ToShortDateString()</span>
						<span class="ms-lg-1">Last chapter: @bookSource.BookMeta.LastChapterReleaseDate!.Value.ToShortDateString()</span>
					</div>
				</div>
				<div class="mt-1 d-flex flex-wrap">
					@foreach(var tag in VisibleTags)
					{
						bool special = (tag.CategoryId == 6 || tag.CategoryId == 7);
						<span class="tag-badge @(special ? "special-tag" : "") me-1 mb-1">@tag.TagName</span>
					}
					@if (SelectedBookSource.Tags.Count() > 7)
					{
						<button class="more-tags-button" @onclick="()=>ToggleTags()">
							@(ShowAllTags ? "-" : "+")
						</button>
					}
				</div>
				<div class="position-relative overflow-hidden">
					@{
						string descState = ShowFullDescription ? "book-description-full" : "book-description-clamped";
					}
					<div class="@descState mt-1">
						@((MarkupString)bookSource.BookMeta.Description!)
					</div>
					<button class="read-more" @onclick="ToggleDescription">
						@(ShowFullDescription ? "Show Less" : "Read More")
					</button>
				</div>
			}
		}
	</div>
</div>

@code{
	[Parameter]
	public BookDTO Book { get; set; } = null!; // we assume that all nested elements are filled and Book is not null

	[Parameter]
	public List<AuthorDTO> Authors { get; set; } = null!; // we assume that Authors are not null

	[Parameter]
	public List<SourceDTO> Sources { get; set; } = null!; // we assume that Sources are not null

	[Parameter]
	public List<TagsCategoryDTO> TagsCategories { get; set; } = null!; // we assume that TagsCategories are not null and is not sorted

	private BookSourceDTO SelectedBookSource { get; set; } = null!;
	private AuthorDTO SelectedAuthor { get; set; } = null!;
	private SourceDTO SelectedSource { get; set; } = null!;

	private List<TagDTO> VisibleTags { get; set; } = null!;

	private bool ShowFullDescription { get; set; } = false;
	private bool ShowAllTags { get; set; } = false;

	private const int visibleTagsNumber = 7;

	protected override void OnInitialized()
	{
		SelectedBookSource = Book.BookSources.First();
		ToggleTags(false);
	}

	private void ToggleDescription()
		=> ShowFullDescription = !ShowFullDescription;

	private void ToggleTags(bool? toggle = null)
	{
		if (toggle.HasValue)
			ShowAllTags = toggle.Value;
		else
			ShowAllTags = !ShowAllTags;

		var query = SelectedBookSource.Tags.OrderByDescending(t => t.CategoryId).AsQueryable();

		if(ShowAllTags)
			VisibleTags = query.ToList();
		else
			VisibleTags = query.Take(visibleTagsNumber).ToList();
	}
}