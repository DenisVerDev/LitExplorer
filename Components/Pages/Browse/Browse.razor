@page "/Browse"
@inject BrowseService BrowseService
@inject MetadataService MetadataService
@inject StorageService Storage

<PageTitle>Browse literature</PageTitle>

<div class="container p-md-3 p-0">
	<div class="row w-100 m-0">
		<div class="col-12 col-md-9 order-2 order-md-1 p-3 rounded-1 books-list">
			<div class="w-100 m-0 ps-2 d-flex align-items-center justify-content-between">
				<h5>Catalog</h5>
				<div>
					<div class="position-relative d-inline-block">
						<button class="litexp-btn litexp-btn-ps btn-sortby" @onclick="ResetSortByAsync" title="Reset sort filters">
							<svg xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							width="18"
							height="18"
							fill="none">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9h13a5 5 0 0 1 0 10H7M3 9l4-4M3 9l4 4" />
							</svg>
						</button>
					</div>
					<!-- Sort Options Container -->
					<div class="position-relative d-inline-block">
						<button class="litexp-btn litexp-btn-ps btn-sortby" id="btnSortByOption" @onclick="()=>SortByPanelState = SortByPanelState.ShowSortByOptions">
							<svg xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							width="18"
							height="18"
							fill="none">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M7 4l3 3M7 4 4 7m9-3h6l-6 6h6m-6.5 10 3.5-7 3.5 7M14 18h4" />
							</svg>
						</button>
						<SortByPanel Filter="@Filter" TargetedState="SortByPanelState.ShowSortByOptions" CurrentState="SortByPanelState"
						OnSortByChange="OnApplyFilterAsync" />
					</div>
					<!-- Sort Type Container -->
					<div class="position-relative d-inline-block">
						<button class="litexp-btn litexp-btn-ps btn-sortby" id="btnSortByType" @onclick="()=>SortByPanelState = SortByPanelState.ShowSortByType">
							<svg xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							width="18"
							height="18"
							fill="none">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 20V10m0 10-3-3m3 3 3-3m5-13v10m0-10 3 3m-3-3-3 3" />
							</svg>
						</button>
						<SortByPanel Filter="@Filter" TargetedState="SortByPanelState.ShowSortByType" CurrentState="SortByPanelState"
						OnSortByChange="OnApplyFilterAsync" />
					</div>
				</div>
			</div>
			<div class="row w-100 m-0 mt-2">
				<SearchBar Filter="Filter" OnSeachByTitle="OnApplyFilterAsync" />
			</div>
			<div class="row w-100 m-0">
				@if ((Books != null && Books.Count > 0) && (Authors != null && Authors.Count > 0))
				{
					foreach (var book in Books)
					{
						<BookRow Book="book"
						Authors="Authors.Where(a => book.BookSources.Any(bs=>bs.BookMeta.AuthorId == a.AuthorId)).ToList()"
						TagsCategories="TagsCategories"
						Sources="Sources" 
						LibraryStatuses="LibraryStatuses"
						SessionUser="SessionUser"/>
					}
				}
				else
				{

				}
			</div>
			<div class="row w-100 m-0 mt-3">
				<Pagination Model="PaginationModel" OnPageChanged="OnApplyFilterAsync" />
			</div>
		</div>
		<div class="col-12 col-md-3 order-1 order-md-2 mb-3 mt-3 mt-md-0">
			@if (TagsCategories != null && TagsCategories.Count > 0)
			{
				<FilterPanel Sources="Sources"
				TagsCategories="TagsCategories"
				Filter="Filter"
				OnApplyFilter="OnApplyFilterAsync"/>
			}
		</div>
	</div>
</div>

@code{
	private List<BookDTO>? Books { get; set; } = null;
	private List<AuthorDTO>? Authors { get; set; } = null;
	private List<TagsCategoryDTO>? TagsCategories { get; set; } = null;
	private List<SourceDTO>? Sources { get; set; } = null;
	private List<LibraryStatusDTO>? LibraryStatuses { get; set; } = null;

	private BrowseFilterDTO Filter { get; set; } = null!;

	private SortByPanelState SortByPanelState { get; set; } = SortByPanelState.Hidden;

	private PaginationModel PaginationModel { get; set; } = null!;

	private const string userKey = "sessionUser";
	private UserDTO? SessionUser { get; set; } = null;

	protected override async Task OnInitializedAsync()
	{
		await InitializeDataAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
		{
			SessionUser = (await Storage.GetValueAsync<UserDTO>(userKey)) as UserDTO;
			await InitializeDataAsync();
		}
	}

	private async Task InitializeDataAsync()
	{
		Filter = new BrowseFilterDTO()
			{
				Tags = new List<int>(),
				Sources = new List<int>()
			};

		PaginationModel = new PaginationModel() { PageSize = 12 };

		await LoadBooksAsync();
		await LoadPagesAsync();
		await LoadMetadataAsync();
	}

	private async Task LoadBooksAsync()
	{
		var browseResponse = await BrowseService.BrowseBooksAsync(Filter, PaginationModel.CurrentPage, PaginationModel.PageSize, SessionUser == null ? 0 : SessionUser.UserId);
		Books = browseResponse?.Books;
		Authors = browseResponse?.Authors;
	}

	private async Task LoadPagesAsync()
	{
		PaginationModel.TotalPages = await BrowseService.GetPagesCountAsync(Filter, PaginationModel.PageSize);
		PaginationModel.CurrentPage = 0;
	}

	private async Task LoadMetadataAsync()
	{
		var tagsCategoriesResponse = await MetadataService.GetTagsCategoriesAsync(true);
		TagsCategories = tagsCategoriesResponse?.OrderByDescending(tc => tc.CategoryId).ToList();

		Sources = await MetadataService.GetSourcesAsync();

		LibraryStatuses = await MetadataService.GetLibraryStatusesAsync();
	}

	private async Task OnApplyFilterAsync(bool resetPagination)
	{
		Books?.Clear();
		Authors?.Clear();

		SortByPanelState = SortByPanelState.Hidden; // ui fix

		if (resetPagination)
			await LoadPagesAsync();

		await LoadBooksAsync();
	}

	private async Task ResetSortByAsync()
	{
		Filter.SortByOption = SortByOptions.ByPopularity;
		Filter.SortByType = SortByType.DESC;

		await OnApplyFilterAsync(true);
	}
}