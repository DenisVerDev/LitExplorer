<div class="bg-white p-1 rounded-1">
	@* 	
	1st part - 5 categories
	2nd part - rating, chapters, year
	3rd part - sources
	4th part - type
	5th part - status
	6th part - reset and apply buttons 
	*@
	<div class="mt-1 mb-1"> @* 1st part *@
		@foreach (var tagCategory in SortedTagsCategories)
		{
			<div class="tag-category p-1 ps-2 pe-2">
				@tagCategory.CategoryName tags
			</div>
		}
	</div>
	<div class="p-1 ps-2 pe-2"> @* 2nd part *@
		<div class="mb-3">
			<label class="fw-semibold text-dark mb-2">Average Rating</label>
			<div class="d-flex align-items-center justify-content-between">
				<input class="range-input" type="text" placeholder="min" />
				<div class="divider"></div>
				<input class="range-input" type="text" placeholder="max" />
			</div>
		</div>

		<div class="mb-3">
			<label class="fw-semibold text-dark mb-2">Chapters Number</label>
			<div class="d-flex align-items-center justify-content-between">
				<input class="range-input" type="text" placeholder="min" />
				<div class="divider"></div>
				<input class="range-input" type="text" placeholder="max" />
			</div>
		</div>

		<div class="mb-1">
			<label class="fw-semibold text-dark mb-2">Release Year</label>
			<div class="d-flex align-items-center justify-content-between">
				<input class="range-input" type="text" placeholder="min" />
				<div class="divider"></div>
				<input class="range-input" type="text" placeholder="max" />
			</div>
		</div>
	</div>
	<div class="p-1 ps-2 pe-2"> @* 3rd part *@
		<label class="fw-semibold text-dark mb-2">Sources</label>
		@foreach (var source in Sources)
		{
			<div class="d-flex align-items-center mb-1">
				<!-- The hidden native checkbox -->
				<input type="checkbox" id="source_@(source.SourceId)" class="litexp-checkbox" />

				<!-- The custom checkbox + label text -->
				<label for="source_@(source.SourceId)" class="litexp-checkbox-label">
					<span class="checkmark"></span>
					<span class="text-dark">@source.SourceName</span>
				</label>
			</div>
		}
	</div>
	<div class="p-1 ps-2 pe-2"> @* 4th part *@
		<label class="fw-semibold text-dark mb-2">Type</label>
		<div class="d-flex gap-3">
			<!-- Left column (Original) -->
			<div class="flex-fill d-flex align-items-center mb-1">
				<input type="checkbox" id="type-original" class="litexp-checkbox" />
				<label for="type-original" class="litexp-checkbox-label">
					<span class="checkmark"></span>
					<span class="text-dark">Original</span>
				</label>
			</div>

			<!-- Right column (Fanfic) -->
			<div class="flex-fill d-flex align-items-center mb-1">
				<input type="checkbox" id="type-fanfic" class="litexp-checkbox" />
				<label for="type-fanfic" class="litexp-checkbox-label">
					<span class="checkmark"></span>
					<span class="text-dark">Fanfic</span>
				</label>
			</div>
		</div>
	</div>
	<div class="p-1 ps-2 pe-2"> @* 5th part *@
		<label class="fw-semibold text-dark mb-2">Status</label>
		<div class="d-flex gap-3">
			<!-- Left column: 3 checkboxes -->
			<div class="flex-fill d-flex flex-column">
				<div class="d-flex align-items-center mb-1">
					<input type="checkbox" id="status-ongoing" class="litexp-checkbox" />
					<label for="status-ongoing" class="litexp-checkbox-label">
						<span class="checkmark"></span>
						<span class="text-dark">Ongoing</span>
					</label>
				</div>
				<div class="d-flex align-items-center mb-1">
					<input type="checkbox" id="status-completed" class="litexp-checkbox" />
					<label for="status-completed" class="litexp-checkbox-label">
						<span class="checkmark"></span>
						<span class="text-dark">Completed</span>
					</label>
				</div>
				<div class="d-flex align-items-center mb-1">
					<input type="checkbox" id="status-stubbed" class="litexp-checkbox" />
					<label for="status-stubbed" class="litexp-checkbox-label">
						<span class="checkmark"></span>
						<span class="text-dark">Stubbed</span>
					</label>
				</div>
			</div>

			<!-- Right column: 2 checkboxes -->
			<div class="flex-fill d-flex flex-column">
				<div class="d-flex align-items-center mb-1">
					<input type="checkbox" id="status-dropped" class="litexp-checkbox" />
					<label for="status-dropped" class="litexp-checkbox-label">
						<span class="checkmark"></span>
						<span class="text-dark">Dropped</span>
					</label>
				</div>
				<div class="d-flex align-items-center mb-1">
					<input type="checkbox" id="status-hiatus" class="litexp-checkbox" />
					<label for="status-hiatus" class="litexp-checkbox-label">
						<span class="checkmark"></span>
						<span class="text-dark">Hiatus</span>
					</label>
				</div>
			</div>
		</div>
	</div>
	<div class="p-1 ps-2 pe-2 mt-1"> @* 6th part *@
		<div class="d-flex align-items-center justify-content-between">
			<button class="litexp-btn litexp-btn-ps btn-fp">Reset</button>
			<button class="litexp-btn litexp-btn-p btn-fp">Apply</button>
		</div>
	</div>
</div>

@code{

	[Parameter]
	public BrowseFilterDTO Filter { get; set; } = null!;

	[Parameter]
	public List<SourceDTO> Sources { get; set; } = null!;

	[Parameter]
	public List<TagsCategoryDTO> TagsCategories { get; set; } = null!;

	private List<TagsCategoryDTO> SortedTagsCategories { get; set; } = null!;

	protected override void OnInitialized()
	{
		SortedTagsCategories = TagsCategories!.OrderBy(tc => tc.CategoryId).Take(5).ToList();
	}
}