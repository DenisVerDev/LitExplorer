@page "/Recommendations"
@inject RecommendationService RecommendationService
@inject MetadataService MetadataService
@inject StorageService Storage

<PageTitle>Recommendations</PageTitle>

<div class="container p-md-3 p-0">
	<div class="row w-100 m-0 justify-content-center">
		<div class="col-12 col-md-9 order-2 order-md-1 p-3 rounded-1 books-list">
			<div class="w-100 m-0 ps-3 d-flex align-items-center justify-content-between">
				<h5>
					@{
						switch (RecomTypePanelModel.RO)
						{
							case RecommendationsOptions.BestOfMonth:
								@("Best of the month")
								break;

							case RecommendationsOptions.Hottest:
								@("Newest additions")
								break;

							case RecommendationsOptions.Personal:
								@("Personal recommendation")
								break;
						}
					}
				</h5>
				<div>
					<div class="position-relative d-inline-block">
						<button class="litexp-btn litexp-btn-ps btn-sortby" @onclick="SortByRecommendationOptionAsync" title="Refresh recommendations">
							<svg xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							width="18"
							height="18"
							fill="none">
								<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.651 7.65a7.131 7.131 0 0 0-12.68 3.15M18.001 4v4h-4m-7.652 8.35a7.13 7.13 0 0 0 12.68-3.15M6 20v-4h4" />
							</svg>
						</button>
					</div>
					<!-- Recommendations Options Container -->
					<div class="position-relative d-inline-block">
						<button class="litexp-btn litexp-btn-ps btn-sortby" id="btnSortByOption" @onclick="()=>RecomTypePanelModel.Visibility = true">
							<svg xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							width="18"
							height="18"
							fill="currentColor">
								<path d="M5.05 3C3.291 3 2.352 5.024 3.51 6.317l5.422 6.059v4.874c0 .472.227.917.613 1.2l3.069 2.25c1.01.742 2.454.036 2.454-1.2v-7.124l5.422-6.059C21.647 5.024 20.708 3 18.95 3H5.05Z" />
							</svg>
						</button>
						<RecomTypePanel Model="RecomTypePanelModel" OnRecomTypeChange="SortByRecommendationOptionAsync" />
					</div>
				</div>
			</div>
			<div class="row w-100 m-0">
				@if ((Books != null && Books.Count > 0) && (Authors != null && Authors.Count > 0))
				{
					foreach (var book in Books)
					{
						<LitExplorer.Components.Pages.Browse.BookRow Book="book"
						Authors="Authors.Where(a => book.BookSources.Any(bs=>bs.BookMeta.AuthorId == a.AuthorId)).ToList()"
						TagsCategories="TagsCategories"
						Sources="Sources" 
						LibraryStatuses="LibraryStatuses"
						SessionUser="SessionUser"
						LibraryStatusChanged="ApplyLibraryStatusOptionAsync"/>
					}
				}
				else
				{
					<h1 class="mt-5 text-center no-books">No books</h1>
				}
			</div>
		</div>
	</div>
</div>

@code {
	private List<BookDTO>? Books { get; set; } = null;
	private List<AuthorDTO>? Authors { get; set; } = null;
	private List<TagsCategoryDTO>? TagsCategories { get; set; } = null;
	private List<SourceDTO>? Sources { get; set; } = null;
	private List<LibraryStatusDTO>? LibraryStatuses { get; set; } = null;

	private RecomTypePanelModel RecomTypePanelModel { get; set; } = null!;

	private const string userKey = "sessionUser";
	private UserDTO? SessionUser { get; set; } = null;

	protected override async Task OnInitializedAsync()
	{
		RecomTypePanelModel = new RecomTypePanelModel();
		await LoadMetadataAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
		{
			SessionUser = (await Storage.GetValueAsync<UserDTO>(userKey)) as UserDTO;
			await LoadBooksAsync();
			StateHasChanged();
		}
	}

	private async Task LoadBooksAsync()
	{
		var browseResponse = await RecommendationService.RecommendBooksAsync(SessionUser, RecomTypePanelModel.RO, 12);
		Books = browseResponse?.Books;
		Authors = browseResponse?.Authors;
	}

	private async Task LoadMetadataAsync()
	{
		var tagsCategoriesResponse = await MetadataService.GetTagsCategoriesAsync(true);
		TagsCategories = tagsCategoriesResponse?.OrderByDescending(tc => tc.CategoryId).ToList();

		Sources = await MetadataService.GetSourcesAsync();

		LibraryStatuses = await MetadataService.GetLibraryStatusesAsync();
	}

	private async Task SortByRecommendationOptionAsync()
	{
		RecomTypePanelModel.Visibility = false;

		Books?.Clear();
		Authors?.Clear();
		await LoadBooksAsync();
	}

	private async Task ApplyLibraryStatusOptionAsync(int bookId)
	{
		var browseResponse = await RecommendationService.RecommendBooksAsync(SessionUser, RecomTypePanelModel.RO, 12);
		var bookResponse = browseResponse?.Books?.Where(b => b.BookId == bookId).FirstOrDefault();

		if (bookResponse != null)
		{
			var websiteBook = Books!.Where(b => b.BookId == bookId).First();
			if (bookResponse.LibraryStatus != null)
			{
				if (websiteBook.LibraryStatus == null)
					websiteBook.LibraryStatus = new LibraryStatusDTO();

				websiteBook.LibraryStatus!.StatusId = bookResponse.LibraryStatus!.StatusId;
				websiteBook.LibraryStatus!.StatusName = bookResponse.LibraryStatus!.StatusName;
			}
			else websiteBook.LibraryStatus = null;
		}
	}
}
